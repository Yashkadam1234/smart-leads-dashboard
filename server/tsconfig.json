{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",

    "rootDir": "..",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": ["node"],
    "ignoreDeprecations": "6.0"
  },

  "include": [
    "src/**/*",
    "../shared/**/*"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}