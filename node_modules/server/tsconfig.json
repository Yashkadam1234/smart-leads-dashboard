{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "../",                // keep server code under src
    "outDir": "./dist",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ],
    "baseUrl": "./src",               // 👈 baseUrl points to src
    "paths": {
      "@shared/*": ["../shared/*"]    // 👈 alias for shared folder
    }
  },
  "include": [
    "src/**/*",
    "../shared/**/*"                  // 👈 include shared files
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
